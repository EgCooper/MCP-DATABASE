# MySQL: use a database account with read-only permissions.
# Existing environment variables take priority over this file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mcp_readonly
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# Optional: positive integers; defaults shown below.
# Connection / network waits are in seconds, query execution is in milliseconds.
# MYSQL_CONNECT_TIMEOUT=10
# MYSQL_READ_TIMEOUT=30
# MYSQL_WRITE_TIMEOUT=30
# MYSQL_QUERY_TIMEOUT_MS=15000

# osTicket custom list referenced by ost_ticket__cdata.listaEmpresa.
# OSTICKET_COMPANY_LIST_ID=3
