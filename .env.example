# MySQL/MariaDB: use a database account with read-only permissions.
# Generate column-level grants with: python -m mcp_mysql grants --database your_database
# Existing environment variables take priority over this file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Required: there is no default account.
MYSQL_USER=mcp_readonly
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# Optional TLS. A CA file enables certificate verification; identity also checks the host name.
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_VERIFY_IDENTITY=false

# Optional: positive integers; defaults shown below.
# Connection / network waits are in seconds, query execution is in milliseconds.
# MYSQL_CONNECT_TIMEOUT=10
# MYSQL_READ_TIMEOUT=30
# MYSQL_WRITE_TIMEOUT=30
# MYSQL_QUERY_TIMEOUT_MS=15000

# osTicket custom list referenced by ost_ticket__cdata.listaEmpresa.
# OSTICKET_COMPANY_LIST_ID=3

# MCP service.
# Required for HTTP on any non-loopback address: clients send "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
# Extra Host headers accepted over HTTP, comma separated (compose.yaml sets mcp-osticket:*).
# MCP_ALLOWED_HOSTS=
# Schema exploration tools (list_tables, describe_table, sample_rows) for administrators.
# MCP_ENABLE_EXPLORATION_TOOLS=false
# Seconds the discovered schema is cached.
# MCP_SCHEMA_CACHE_SECONDS=300
# Maximum simultaneous database connections; extra calls wait up to 30 s.
# MCP_MAX_DB_CONNECTIONS=8
# Read-only connections kept open and reused between calls (0 disables; capped by the value above).
# Connections idle for 5 minutes are dropped; a connection that saw any error is never reused.
# MCP_DB_POOL_SIZE=4
# Pooled connections are replaced after this many seconds, even if healthy.
# MCP_DB_POOL_MAX_LIFETIME_SECONDS=1800
